@page "/loginPage"
@inject UrlAddress client
<div class="login-page">
    <header class="page-header">
        <h1>Вход</h1>
    </header>

    <main class="login-container">
        <div class="input-fields">
            <div class="input_phone">
                <h3>Номер для входа</h3>
                <input @bind="phone" @bind:event="oninput" type="tel" placeholder="+7 (123)-456-78-90" />
            </div>
            <div class="input_password">
                <h3>Пароль</h3>
                <input @bind="password" @bind:event="oninput" type="password" />
                <a>Забыли пароль?</a>
            </div>
        </div>
    </main>

    <footer class="page-footer">
        <button @onclick="Login" class="button-login">Войти</button>
        <p>@message</p>
    </footer>
</div>

@code {
    private string phone = "";
    private string password = "";
    private LoginDTO user = new LoginDTO();
    private string message = "";
    public async Task Login()
    {
        try
        {


            user.Password = password;
            user.Phone = phone;
            var response = await client.httpClient.PostAsJsonAsync(
            "api/v1/auth/login", user
        );

            if (response.IsSuccessStatusCode)
            {
                message = "Успешный вход!";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                message = "Неуспешный вход!";
            }
        }
        catch(Exception ex)
        {
            message = ex.ToString();
        }
    }
}